{
  "manifest_version": 3,
  "name": "FocusTracker",
  "description": "Track time spent on websites, block distracting sites, and sync productivity reports.",
  "version": "1.0",
  "icons": {
    "16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"
  },
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "service_worker.js" },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "identity",
    "activeTab",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "sessions"
  ],
  "host_permissions": ["<all_urls>"],
  "optional_permissions": ["webRequest", "webRequestBlocking"],
  "declarative_net_request": { "rule_resources": [] }
}
